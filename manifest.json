{
  "manifest_version": 3,
  "name": "M-Pesa Code Extractor",
  "version": "1.0.0",
  "description": "Paste an M-Pesa payment screenshot and instantly get the M-Pesa code and invoice/account number, ready to copy.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "M-Pesa Code Extractor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://tessdata.projectnaptha.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
